<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[5.0.0]" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../third-party/roslyn/LICENSE.txt" Link="notices/roslyn/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_CodeAnalysis_CSharp_Workspaces)/ThirdPartyNotices.rtf" Link="notices/roslyn/ThirdPartyNotices.rtf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

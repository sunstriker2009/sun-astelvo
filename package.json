{
  "name": "@sun-workspace/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=10000 tests/protocol.test.mjs tests/host-client.test.mjs tests/portable.test.mjs",
    "test:host": "node --test --test-timeout=15000 tests/host.integration.test.mjs",
    "build:host": "dotnet build src/Sun.Workspace.Host -c Release",
    "start": "electron .",
    "smoke": "electron desktop/smoke.mjs",
    "package:portable": "node tools/package.mjs",
    "smoke:portable": "node tools/portable-smoke.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
